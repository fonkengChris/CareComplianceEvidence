{
  "name": "@care/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:mock": "bun run src/db/mock.ts",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.51",
    "@care/shared": "workspace:*",
    "ai": "^7.0.84",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.0",
    "express": "^5.0.0",
    "jose": "^6.2.8",
    "postgres": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "drizzle-kit": "^0.31.0"
  }
}
