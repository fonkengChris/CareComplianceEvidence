# Copy to .env and adjust for your local setup.

# --- Database ---
# Local system PostgreSQL (peer auth over the unix socket for the current OS user):
DATABASE_URL=postgresql:///care_tracker?host=/var/run/postgresql
# Or TCP with an explicit user/password:
# DATABASE_URL=postgresql://user:password@localhost:5432/care_tracker
# Cloud (Neon) — use the *pooled* connection string and keep sslmode=require:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require

PORT=3000
# Set to `production` in the cloud. Enables secure cookies, requires JWT_SECRET, and
# makes the server serve the built SPA from apps/client/dist.
# NODE_ENV=production

# --- Auth (Phase 2) ---
# HMAC secret for signing access-token JWTs. REQUIRED in production; a dev fallback
# is used when unset outside production. Generate one with: openssl rand -hex 32
JWT_SECRET=dev-insecure-jwt-secret-change-me
# Access-token lifetime (jose duration string, e.g. 15m, 1h).
ACCESS_TOKEN_TTL=15m
# Refresh-token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# Optional: override where the server looks for the built client (defaults to
# apps/client/dist relative to the working directory).
# CLIENT_DIST_PATH=/app/apps/client/dist

# --- AI "polish activity record" + speech-to-text (staff recording) ---
# OpenAI API key that powers the Polish and Speak (dictation) buttons on the recording
# screen. Optional: when unset both features are disabled and the endpoints answer 503
# (nothing else breaks).
# OPENAI_API_KEY=sk-...
# Optional model override for polish (defaults to gpt-4.1-nano).
# AI_POLISH_MODEL=gpt-4.1-nano
# Optional speech-to-text model (defaults to gpt-4o-mini-transcribe).
# AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional cap on uploaded audio size in bytes (defaults to 25 MB).
# AI_TRANSCRIBE_MAX_BYTES=26214400

# Seeded dev users (see db/seed.ts) all share this password: Password123!
# Accounts: manager@example.com / staff@example.com / auditor@example.com
